<?xml version="1.0" encoding="utf-8"?>
<!--
  The app picker's body, shown inside an AlertDialog.

  A search box over a plain ListView. The list is backed by an ArrayAdapter<AppEntry>
  whose toString() is "label - package", which is what ArrayAdapter's built-in filter
  matches on, so one TextWatcher searches both the visible name and the package id,
  and getItem(position) still returns the right entry after filtering.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="Search apps"
        app:hintTextColor="@color/colorPrimary"
        app:boxStrokeColor="@color/colorPrimary"
        app:startIconDrawable="@android:drawable/ic_menu_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAppSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@android:color/black" />
    </com.google.android.material.textfield.TextInputLayout>

    <ListView
        android:id="@+id/listApps"
        android:layout_width="match_parent"
        android:layout_height="360dp" />

</LinearLayout>
