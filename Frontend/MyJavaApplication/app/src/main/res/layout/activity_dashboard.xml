<?xml version="1.0" encoding="utf-8"?>
<!--
  The dashboard reads top to bottom as an answer: what you pay and what you could stop
  paying (the summary "receipt"), where your time actually goes (the chart), then a
  verdict per subscription.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            style="@style/Widget.Insight.CollapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:title="Your month">

            <TextView
                style="@style/Text.Insight.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="What you pay, and what you get for it."
                app:layout_collapseMode="parallax" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationContentDescription="Back"
                app:navigationIcon="@drawable/ic_arrow_back" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">

            <!--
              Shown only when the newest month with data is not this one, so last
              month's figures are never mistaken for this month's.
            -->
            <TextView
                android:id="@+id/tvPeriodNotice"
                style="@style/Text.Insight.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_notice"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:visibility="gone" />

            <!--
              Account totals, laid out like a receipt. Starts GONE and is only shown once
              the summary call succeeds: a card full of zeros is worse than no card,
              because it looks like the figures are genuinely zero.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvSummaryPeriod"
                        style="@style/Text.Insight.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This month" />

                    <TextView
                        style="@style/Text.Insight.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="You're paying" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSummarySpend"
                            style="@style/Text.Insight.Figure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0" />

                        <TextView
                            style="@style/Text.Insight.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="a month" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSummaryCount"
                        style="@style/Text.Insight.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="across 0 active subscriptions" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/divider_dashed"
                        android:layerType="software" />

                    <TextView
                        style="@style/Text.Insight.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You could stop paying" />

                    <!-- The figure the product exists to give, so it gets the highlighter. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSummarySavings"
                            style="@style/Text.Insight.Figure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_highlight"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="₹0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Insight.Caption"
                            android:layout_marginStart="6dp"
                            android:text="a month" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSummaryWaste"
                        style="@style/Text.Insight.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0% of your spend" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Text.Insight.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Where your time goes" />

            <TextView
                android:id="@+id/tvChartCaption"
                style="@style/Text.Insight.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="Time in each app on this phone, coloured by its verdict." />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <!-- Height is set from DashboardActivity, so each bar gets the same room. -->
                <com.github.mikephil.charting.charts.HorizontalBarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_margin="12dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Text.Insight.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The verdicts" />

            <TextView
                style="@style/Text.Insight.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="What each one costs per hour you actually use it." />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
