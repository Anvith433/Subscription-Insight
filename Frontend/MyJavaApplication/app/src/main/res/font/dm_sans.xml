<?xml version="1.0" encoding="utf-8"?>
<!--
  The UI face. Declared as a family so textStyle="bold" picks the 700 cut instead of
  synthesising one. Both namespaces are set because minSdk is 24 and the android: ones
  are only read from API 26; AppCompat reads the app: ones below that.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/dm_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/dm_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/dm_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/dm_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/dm_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/dm_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
