<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Text. Two faces: Fraunces for headlines and the money figures, DM Sans for
      everything you read. Applied with style=, not android:textAppearance, because the
      theme-level font would outrank a textAppearance (see themes.xml).
    -->
    <style name="Text.Insight" parent="">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="fontFamily">@font/dm_sans</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.Insight.Display">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="fontFamily">@font/fraunces_semibold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>

    <style name="Text.Insight.Headline">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="fontFamily">@font/fraunces_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!--
      A money figure that is the point of its card. No font padding, so the line box is
      just the glyphs and bg_highlight's fixed insets land on the lower half of them.
    -->
    <style name="Text.Insight.Figure">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="fontFamily">@font/fraunces_semibold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- A figure in a row of figures: list prices, the stat strip on a verdict. -->
    <style name="Text.Insight.Stat">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="fontFamily">@font/fraunces_semibold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Text.Insight.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Insight.Body">
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Text.Insight.Caption">
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Insight.Overline">
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Package names: shown because they are what the usage matcher keys on. -->
    <style name="Text.Insight.Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="fontFamily">monospace</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">middle</item>
    </style>

    <style name="Text.Insight.Pill">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">@drawable/bg_pill</item>
    </style>

    <style name="Text.Insight.StepNumber">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="fontFamily">@font/fraunces_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_step_number</item>
    </style>

    <!-- Stands in for an app icon when the app is not installed on this phone. -->
    <style name="Text.Insight.Monogram">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="fontFamily">@font/fraunces_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_monogram</item>
    </style>

    <!-- Read by Material directly, not by a TextView, so textAppearance is right here. -->
    <style name="TextAppearance.Insight.LargeTitle" parent="">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="fontFamily">@font/fraunces_semibold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Insight.ToolbarTitle" parent="">
        <item name="android:fontFamily">@font/dm_sans_bold</item>
        <item name="fontFamily">@font/dm_sans_bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Widgets. Wired up in themes.xml, so layouts get these without asking. -->

    <style name="Widget.Insight.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/dm_sans_bold</item>
        <item name="fontFamily">@font/dm_sans_bold</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="backgroundTint">@color/button_background</item>
        <item name="rippleColor">@color/ripple_on_ink</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Insight.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/dm_sans_bold</item>
        <item name="fontFamily">@font/dm_sans_bold</item>
    </style>

    <!-- Flat paper cards with a hairline edge; nothing in the app casts a shadow but the FAB. -->
    <style name="Widget.Insight.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Insight.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/card</item>
        <item name="boxStrokeColor">@color/field_stroke_selector</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="helperTextTextColor">@color/ink_muted</item>
        <item name="endIconTint">@color/ink_muted</item>
        <item name="startIconTint">@color/ink_muted</item>
    </style>

    <style name="Widget.Insight.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Insight.ToolbarTitle</item>
    </style>

    <!--
      The large serif title every inner screen opens with. It shrinks into the toolbar on
      scroll; the bottom margin leaves room for the one-line subtitle under it.
    -->
    <style name="Widget.Insight.CollapsingToolbar" parent="Widget.Design.CollapsingToolbar">
        <item name="contentScrim">@color/paper</item>
        <item name="statusBarScrim">@android:color/transparent</item>
        <item name="expandedTitleTextAppearance">@style/TextAppearance.Insight.LargeTitle</item>
        <item name="collapsedTitleTextAppearance">@style/TextAppearance.Insight.ToolbarTitle</item>
        <item name="expandedTitleMarginStart">20dp</item>
        <item name="expandedTitleMarginEnd">20dp</item>
        <item name="expandedTitleMarginBottom">42dp</item>
        <item name="scrimAnimationDuration">180</item>
    </style>

    <style name="Widget.Insight.Fab" parent="Widget.MaterialComponents.ExtendedFloatingActionButton.Icon">
        <item name="backgroundTint">@color/ink</item>
        <item name="android:textColor">@color/on_ink</item>
        <item name="iconTint">@color/on_ink</item>
        <item name="rippleColor">@color/ripple_on_ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/dm_sans_bold</item>
        <item name="fontFamily">@font/dm_sans_bold</item>
    </style>
</resources>
