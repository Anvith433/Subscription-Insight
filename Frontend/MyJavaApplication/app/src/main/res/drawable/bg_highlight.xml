<?xml version="1.0" encoding="utf-8"?>
<!--
  A highlighter pass under the lower half of a figure, as if someone had marked the one
  number on the page that matters. Only the savings figure gets it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="5dp"
        android:top="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/highlight" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
